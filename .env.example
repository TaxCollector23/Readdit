# Readdit configuration. Copy this file to .env and fill in the values.
# Shared by the CLI, MCP server, and web app — see README.md for details.

# Required. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any OpenRouter-listed model id. Defaults to openai/gpt-4o-mini.
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. SQLite file used for caching, rate limits, and (web app) users/history.
DATABASE_URL=./data/readdit.db

# Required for the web app. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Optional. Cache TTL for research results, in seconds. Defaults to 21600 (6h).
READDIT_CACHE_TTL_SECONDS=21600

# Optional. Max live analyses per signed-in user per hour on the web playground.
READDIT_RATE_LIMIT_PER_HOUR=20

# Optional. Set to 1 to use deterministic mock search/analysis providers
# instead of real Reddit search + OpenRouter — useful for local development
# and tests without spending API budget.
READDIT_MOCK_PROVIDERS=0

# Optional. Set to 1 for verbose structured logs on stderr.
READDIT_VERBOSE=0
